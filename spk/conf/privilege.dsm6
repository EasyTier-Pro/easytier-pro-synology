{
	"defaults": {
		"run-as": "package"
	},
	"username": "easytier-pro",
	"groupname": "easytier-pro",
	"ctrl-script": [
		{
			"action": "postinst",
			"run-as": "root"
		},
		{
			"action": "postuninst",
			"run-as": "root"
		},
		{
			"action": "start",
			"run-as": "root"
		},
		{
			"action": "stop",
			"run-as": "root"
		}
	]
}
