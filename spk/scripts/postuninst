#!/bin/sh
# Remove everything this client stored: enrollment token, Console session,
# machine identity, downloaded runtime, cached archive and logs.
#
# DSM also runs this script while upgrading (SYNOPKG_PKG_STATUS=UPGRADE), so the
# state may only be deleted for a real uninstall.

case "$SYNOPKG_PKG_STATUS" in
	UPGRADE) exit 0 ;;
esac

NGINX_TARGET="/usr/syno/share/nginx/conf.d/dsm.easytier-pro.conf"

dsm_major_version() {
	if [ -r /etc/VERSION ]; then
		awk -F'"' '/^majorversion=/ { print $2; exit }' /etc/VERSION
	fi
}

# DSM 6 does not export SYNOPKG_PKGVAR to lifecycle scripts; use the package's
# etc directory, which is owned by the package user.
PKGVAR="${SYNOPKG_PKGVAR:-/usr/syno/etc/packages/easytier-pro/var}"

for sub in state runtime logs run cache; do
	if [ -e "$PKGVAR/$sub" ] && ! rm -rf "$PKGVAR/$sub"; then
		echo "无法删除 $PKGVAR/$sub，请检查权限后重试。" >&2
		exit 1
	fi
done

# DSM 7 removes the web-config worker link itself; DSM 6 keeps the copy the
# package installed, which must not survive the package.
case "$(dsm_major_version)" in
	6*)
		if [ -f "$NGINX_TARGET" ]; then
			rm -f "$NGINX_TARGET"
			if nginx -t >/dev/null 2>&1; then
				nginx -s reload >/dev/null 2>&1 || true
			fi
		fi
		# Remove the var directory itself on DSM 6, which lives outside the
		# standard package tree.
		rm -rf "$PKGVAR"
		;;
esac

exit 0
