#!/bin/sh
# DSM 7 uses the web-config resource worker to link the bundled nginx snippet
# into the running configuration; DSM 6 has no such worker, so the package
# installs the same snippet into the nginx include directory itself.

NGINX_SNIPPET="$SYNOPKG_PKGDEST/nginx/dsm.easytier-pro.conf"
NGINX_INCLUDE_DIR="/usr/syno/share/nginx/conf.d"
NGINX_TARGET="$NGINX_INCLUDE_DIR/dsm.easytier-pro.conf"

dsm_major_version() {
	if [ -r /etc/VERSION ]; then
		awk -F'"' '/^majorversion=/ { print $2; exit }' /etc/VERSION
	fi
}

install_nginx_snippet() {
	[ -f "$NGINX_SNIPPET" ] || return 0
	mkdir -p "$NGINX_INCLUDE_DIR" || return 1
	cp "$NGINX_SNIPPET" "$NGINX_TARGET" || return 1
	if nginx -t >/dev/null 2>&1; then
		nginx -s reload >/dev/null 2>&1 || true
		return 0
	fi
	rm -f "$NGINX_TARGET"
	return 1
}

case "$(dsm_major_version)" in
	6*)
		# Always install the current snippet: on upgrade the previous copy
		# survives (postuninst skips cleanup for UPGRADE), and skipping the
		# copy because a route already exists would pin the old snippet.
		if ! install_nginx_snippet; then
			echo "无法注册 EasyTier Pro 的 nginx 路由，请检查 nginx 配置。" >&2
			exit 1
		fi

		# Create the var directory for the daemon's pid file, logs and runtime
		# state. Use the package's etc directory, which is owned by the package
		# user (DSM 6 does not export SYNOPKG_PKGVAR to lifecycle scripts).
		mkdir -p /usr/syno/etc/packages/easytier-pro/var/run /usr/syno/etc/packages/easytier-pro/var/logs /usr/syno/etc/packages/easytier-pro/var/state /usr/syno/etc/packages/easytier-pro/var/runtime /usr/syno/etc/packages/easytier-pro/var/cache
		chown -R easytier-pro:easytier-pro /usr/syno/etc/packages/easytier-pro/var
		;;
esac

exit 0
